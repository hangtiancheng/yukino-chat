# Development — absolute origin of the backend (CORS is enabled server-side):
VITE_API_URL=http://localhost:8000

# Production behind the Nginx edge — same-origin prefix proxied to the backend
# (this is what docker/nginx.Dockerfile bakes in):
# VITE_API_URL=/api

# Optional absolute ws(s):// override; by default the WebSocket base is derived
# from VITE_API_URL (scheme swap for absolute origins, page origin for /api).
# VITE_WS_URL=
