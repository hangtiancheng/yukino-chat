# ---- Database feature flag -------------------------------------------------
# pg (default): PostgreSQL. sqlite: local file database.
DATABASE_PROVIDER=pg
# pg mode — full connection string:
DATABASE_URL=postgresql://yukino:yukino@localhost:5432/yukino_chat
# sqlite mode — file: URL (relative paths resolve against server/):
# DATABASE_PROVIDER=sqlite
# DATABASE_URL=file:./prisma-sqlite/dev.db

# ---- Server ----------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
JWT_SECRET=yukino-chat-jwt-secret
TOKEN_EXPIRE_HOURS=336

# ---- Cache ------------------------------------------------------------------
# Empty string runs the cache fully in memory (intended for tests).
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ---- Uploads & telemetry (created on boot) ----------------------------------
STATIC_AVATAR_DIR=./static/avatars
STATIC_FILE_DIR=./static/files
STATIC_CHUNK_DIR=./static/chunks
SENTRY_LOG_DIR=./logs

# ---- Agent runtime -----------------------------------------------------------
AGENT_WS_MAX_MESSAGE_BYTES=4194304
AGENT_IDLE_MS=1800000
AGENT_QUEUE_CAP=8
AGENT_INTERACTION_TIMEOUT_MS=300000

# ---- Fallback LLM provider (only used when no ~/.yukino/config.yaml exists) --
# protocol: anthropic | openai | openai-compat (empty defaults to openai-compat)
YUKINO_AI_PROTOCOL=
YUKINO_AI_BASE_URL=
YUKINO_AI_API_KEY=
YUKINO_AI_MODEL=
