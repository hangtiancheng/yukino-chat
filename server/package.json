{
  "name": "server",
  "version": "1.0.0",
  "description": "yukino-chat backend (TypeScript/Hono)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "format": "biome format --write",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.7.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@yukino.js/yukino": "0.0.20",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "hono": "^4.13.14",
    "ioredis": "^5.11.1",
    "minio": "^8.0.7",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/archiver": "^7.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "prisma": "^7.10.1",
    "rollup": "^4.67.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
